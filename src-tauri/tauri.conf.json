{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fokus",
  "version": "0.2.0",
  "identifier": "de.fokus.lernapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fokus",
        "width": 1280,
        "height": 820,
        "minWidth": 300,
        "minHeight": 120,
        "center": true,
        "visible": false,
        "backgroundColor": "#F4F2EC"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Fokus",
    "category": "Productivity",
    "shortDescription": "Lern-App mit Pomodoro-Timer",
    "longDescription": "Fokus – Pomodoro-Timer, Kalender, Aufgaben, Musik und Lernstatistiken für den Unialltag.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyNzExNEM5RTc1NDNBNUUKUldSZU9sVG55UlJ4RW5QMUhJbmdydWl4b3QwTENINlZyWHNqMTlLZWN5THduVkc3RnJKSmhjc0sK",
      "endpoints": [
        "https://github.com/Jdkdnfixks/Fokus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
